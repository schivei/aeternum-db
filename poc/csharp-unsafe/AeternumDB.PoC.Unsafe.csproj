<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- NativeAOT / Trimming compatibility -->
    <PublishAot>false</PublishAot><!-- set true when publishing for AOT verification -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <AssemblyName>AeternumDB.PoC.Unsafe</AssemblyName>
    <RootNamespace>AeternumDB.PoC.Unsafe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- BenchmarkDotNet 0.13.12 — no known vulnerabilities -->
    <PackageReference Include="BenchmarkDotNet" Version="0.13.12" />
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.13.12" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>
</Project>
